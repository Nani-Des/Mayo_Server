# Mayo EMR Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mayo_db
DB_USER=mayo
DB_PASSWORD=mayo_dev_password

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================
# KAFKA CONFIGURATION
# ==============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==============================================
# JWT CONFIGURATION
# ==============================================
# IMPORTANT: Generate a secure secret for production!
# Use: openssl rand -base64 64
JWT_SECRET=changeme-this-is-not-secure-for-production-use-at-least-64-characters-long
JWT_ACCESS_TOKEN_EXPIRY=900000        # 15 minutes in milliseconds
JWT_REFRESH_TOKEN_EXPIRY=604800000    # 7 days in milliseconds

# ==============================================
# SUPABASE CONFIGURATION (Optional)
# ==============================================
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================
# MINIO CONFIGURATION
# ==============================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=mayo
MINIO_SECRET_KEY=mayo_dev_password
MINIO_BUCKET=mayo-medical-documents

# ==============================================
# SERVICE PORTS
# ==============================================
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PATIENT_SERVICE_PORT=8082
MEDICAL_RECORD_SERVICE_PORT=8083
HOSPITAL_SERVICE_PORT=8084
SYNC_SERVICE_PORT=8085
AUDIT_SERVICE_PORT=8086

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=INFO
SQL_SHOW_SQL=false
SQL_DEBUG=false

# ==============================================
# ENVIRONMENT
# ==============================================
ENVIRONMENT=development  # development, staging, production
